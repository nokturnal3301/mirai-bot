{
	"name": "mirai-bot",
	"version": "1.0.0",
	"description": "Fast Telegram bot for downloading videos from Instagram, TikTok, and YouTube",
	"author": "Mikhail Demidoff <demidoff.mikhail@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
